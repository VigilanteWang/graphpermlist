{
  "name": "@graph/catalog-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "typesVersions": {
    "*": {
      "model": ["dist/esm/model.d.ts"],
      "json-validation": ["dist/esm/json-validation.d.ts"],
      "json-client": ["dist/esm/json-client.d.ts"]
    }
  },
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    },
    "./model": {
      "import": { "types": "./dist/esm/model.d.ts", "default": "./dist/esm/model.js" },
      "require": { "types": "./dist/cjs/model.d.ts", "default": "./dist/cjs/model.js" }
    },
    "./json-validation": {
      "import": { "types": "./dist/esm/json-validation.d.ts", "default": "./dist/esm/json-validation.js" },
      "require": { "types": "./dist/cjs/json-validation.d.ts", "default": "./dist/cjs/json-validation.js" }
    },
    "./json-client": {
      "import": { "types": "./dist/esm/json-client.d.ts", "default": "./dist/esm/json-client.js" },
      "require": { "types": "./dist/cjs/json-client.d.ts", "default": "./dist/cjs/json-client.js" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cjs.json --noEmit"
  },
  "dependencies": { "@graph/contracts": "0.1.0" }
}
