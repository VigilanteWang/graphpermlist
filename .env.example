# Used by API when invoked from repository root. No credentials required.
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173
SQLITE_PATH=./var/catalog.sqlite
# Run db:migrate, then import:data before querying the catalog.
# The default catalog uses all resources in data/catalog-resources.json.
# PERMISSIONS_CONFIG=./data/catalog-resources.json
# PERMISSIONS_SOURCE selects one Graph file for SQLite import and verify:data.
# JSON export uses the default manifest or the PERMISSIONS_CONFIG override.
# PERMISSIONS_SOURCE=./data/commercial-graph-permlist.json
# PERMISSIONS_SHA256=
